generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─────────────────────────────────────────────
// USER / ADMIN / AGENT
// ─────────────────────────────────────────────

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(ADMIN)

  properties Property[]
  inquiries  Inquiry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// LOCATION
// ─────────────────────────────────────────────

model City {
  id        Int      @id @default(autoincrement())
  name      String   @unique

  areas     Area[]
  properties Property[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Area {
  id      Int    @id @default(autoincrement())
  name    String

  cityId  Int
  city    City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  properties Property[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cityId, name])
}

// ─────────────────────────────────────────────
// PROPERTY
// ─────────────────────────────────────────────

model Property {
  id          Int            @id @default(autoincrement())
  title       String
  slug        String         @unique
  description String         @db.Text

  purpose     PropertyPurpose
  type        PropertyType
  status      PropertyStatus @default(AVAILABLE)

  price       Decimal        @db.Decimal(15, 2)

  // Property size
  areaSize    Decimal?       @db.Decimal(12, 2)
  areaUnit    AreaUnit?

  // House / Flat specific
  bedrooms    Int?
  bathrooms   Int?

  // Flat / Building specific
  floor       Int?

  // Location
  cityId      Int
  city        City           @relation(fields: [cityId], references: [id])

  areaId      Int?
  area        Area?          @relation(fields: [areaId], references: [id])

  // Agent / owner responsible for property
  agentId     Int?
  agent       User?          @relation(fields: [agentId], references: [id], onDelete: SetNull)

  // Relations
  images      PropertyImage[]
  amenities   PropertyAmenity[]
  inquiries   Inquiry[]

  // Website controls
  featured    Boolean        @default(false)
  published   Boolean        @default(true)

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([purpose])
  @@index([type])
  @@index([status])
  @@index([cityId])
  @@index([areaId])
  @@index([price])
  @@index([featured])
}

// ─────────────────────────────────────────────
// PROPERTY IMAGES
// ─────────────────────────────────────────────

model PropertyImage {
  id         Int      @id @default(autoincrement())
  imageUrl   String
  isPrimary  Boolean  @default(false)
  sortOrder  Int      @default(0)

  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@index([propertyId])
}

// ─────────────────────────────────────────────
// AMENITIES
// ─────────────────────────────────────────────

model Amenity {
  id         Int              @id @default(autoincrement())
  name       String           @unique

  properties PropertyAmenity[]

  createdAt  DateTime         @default(now())
}

model PropertyAmenity {
  propertyId Int
  amenityId  Int

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
}

// ─────────────────────────────────────────────
// INQUIRIES / LEADS
// ─────────────────────────────────────────────

model Inquiry {
  id          Int           @id @default(autoincrement())

  name        String
  phone       String
  email       String?
  message     String?       @db.Text

  status      InquiryStatus @default(NEW)

  propertyId  Int
  property    Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  assignedToId Int?
  assignedTo   User?        @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([propertyId])
  @@index([status])
  @@index([assignedToId])
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  ADMIN
  AGENT
}

enum PropertyPurpose {
  SALE
  RENT
}

enum PropertyType {
  HOUSE
  FLAT
  PLOT
  COMMERCIAL
}

enum PropertyStatus {
  AVAILABLE
  SOLD
  RENTED
}

enum AreaUnit {
  MARLA
  KANAL
  SQ_FT
  SQ_YD
  SQ_M
}

enum InquiryStatus {
  NEW
  CONTACTED
  VISITED
  NEGOTIATING
  CLOSED
  LOST
}